pipeline {
    agent any

    environment {
        POSTGRES_CONTAINER = 'user-postgres'
        OVERTIME_POSTGRES_USER_PORT = credentials('OVERTIME_POSTGRES_USER_PORT')
        OVERTIME_POSTGRES_AI_PORT = credentials('OVERTIME_POSTGRES_AI_PORT')
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: 'dev', url: 'https://github.com/challduck/jenkins-practis.git'
            }
        }

        stage('Start PostgreSQL and Test') {
            steps {
                script {
                    sh "docker compose -f docker-compose.db.yml up -d"

                    timeout(time: 30, unit: 'SECONDS') {
                        waitUntil {
                            echo 'Checking PostgreSQL health...'
                            def health = sh(script: "docker inspect --format='{{.State.Health.Status}}' ${POSTGRES_CONTAINER}", returnStdout: true).trim()
                            echo "Current health: ${health}"
                            return health == "healthy"
                        }
                    }

                    sh "chmod +x gradlew"
                    sh "./gradlew test -Dspring.datasource.url=jdbc:postgresql://host.docker.internal:$OVERTIME_POSTGRES_USER_PORT/overtime"
                    echo 'test success'
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up Docker Compose services and volumes...'
            sh "docker compose -f docker-compose.db.yml down -v"
        }
        success {
            echo '테스트 및 빌드 성공'
        }
        failure {
            echo '테스트 또는 빌드 실패'
        }
    }
}
