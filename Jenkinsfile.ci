pipeline {
    agent any

    environment {
        POSTGRES_CONTAINER = 'user-postgres'
        OVERTIME_POSTGRES_USER_PORT = credentials('OVERTIME_POSTGRES_USER_PORT')
        OVERTIME_POSTGRES_AI_PORT = credentials('OVERTIME_POSTGRES_AI_PORT')
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: 'dev', url: 'https://github.com/challduck/jenkins-practis.git'
            }
        }

        stage('Start PostgreSQL and Test') {
            steps {
                script {

                    sh "docker compose -f docker-compose.db.yml up -d"

                    timeout(time: 30, unit: 'SECONDS') {
                        waitUntil {
                            def status = sh(script: "docker exec ${POSTGRES_CONTAINER} pg_isready -U postgres -h localhost", returnStatus: true)
                            return status == 0
                        }
                    }

                    sh "chmod +x gradlew"
                    sh "./gradlew test -Dspring.datasource.url=jdbc:postgresql://host.docker.internal:${env.OVERTIME_POSTGRES_USER_PORT}/overtime"
                    echo 'test success'
                }
            }
        }
    }

    post {
        success {
            echo '테스트 및 빌드 성공'
        }
        failure {
            echo '테스트 또는 빌드 실패'
        }
    }
}
