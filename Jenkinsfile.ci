pipeline {
    agent any

    stages {
        stage('Git Clone') {
            steps {
                git branch: 'dev', url: 'https://github.com/challduck/jenkins-practis.git'
            }
        }

        stage('Start PostgreSQL and Test') {
            steps {
                script {
                    docker.image('postgres:13').withRun(
                        '-e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=jenkins -p 5432:5432 --rm --volumes'
                    ) { c ->
                        // PostgreSQL이 준비될 때까지 대기
                        timeout(time: 30, unit: 'SECONDS') {
                            waitUntil {
                                def status = sh(script: "pg_isready -h localhost -p 5432", returnStatus: true)
                                return status == 0
                            }
                        }
                        sh 'chmod +x gradlew'
                        // 빌드 및 테스트 실행
                        sh './gradlew test -Dspring.datasource.url=jdbc:postgresql://localhost:5432/jenkins'
                        echo 'test success'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean build'
                echo 'build success'
            }
        }
    }
    post {
        success {
            echo '테스트 및 빌드 성공'
        }
        failure {
            echo '테스트 또는 빌드 실패'
        }
    }
}
