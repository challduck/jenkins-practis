pipeline {
    agent any

    environment {
        POSTGRES_CONTAINER = 'jenkins-postgres'
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: 'dev', url: 'https://github.com/challduck/jenkins-practis.git'
            }
        }

        stage('Start PostgreSQL and Test') {
            steps {
                script {
                    docker.image('postgres:13').withRun(
                        "--name ${POSTGRES_CONTAINER} " +
                        "-e POSTGRES_USER=postgres " +
                        "-e POSTGRES_PASSWORD=postgres " +
                        "-e POSTGRES_DB=jenkins " +
                        "-p 5432:5432 " +
                        "--rm"
                    ) { c ->

                        // PostgreSQL이 준비될 때까지 대기 (컨테이너 내부에서 실행)
                        timeout(time: 30, unit: 'SECONDS') {
                            waitUntil {
                                def status = sh(script: "docker exec ${POSTGRES_CONTAINER} pg_isready -U postgres -h localhost", returnStatus: true)
                                return status == 0
                            }
                        }

                        sh 'chmod +x gradlew'
                        // 빌드 및 테스트 실행
                        sh './gradlew test -Dspring.datasource.url=jdbc:postgresql://host.docker.internal:5432/jenkins'
                        echo 'test success'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "PostgreSQL 컨테이너 정리 중..."
                def exists = sh(script: "docker ps -a --filter 'name=${POSTGRES_CONTAINER}' --format '{{.ID}}'", returnStdout: true).trim()
            }
        }
        success {
            echo '테스트 및 빌드 성공'
        }
        failure {
            echo '테스트 또는 빌드 실패'
        }
    }
}
